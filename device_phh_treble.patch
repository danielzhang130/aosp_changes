From 3c51cd409bf002dc22292945e7d2c3f35d71bc55 Mon Sep 17 00:00:00 2001
From: Daniel Zhang <danielzhang130@gmail.com>
Date: Wed, 14 Dec 2022 21:07:13 -0500
Subject: [PATCH 02/31] Passes safetynet out of the box

remove unneeded system prop changes

Signed-off-by: Daniel Zhang <danielzhang130@gmail.com>
---
 rw-system.sh | 6 ------
 1 file changed, 6 deletions(-)

diff --git a/rw-system.sh b/rw-system.sh
index 9845a30..1f79f8a 100644
--- a/rw-system.sh
+++ b/rw-system.sh
@@ -787,8 +787,6 @@ copyprop() {
 }
 if [ -f /system/phh/secure ] || [ -f /metadata/phh/secure ];then
     copyprop ro.build.device ro.vendor.build.device
-    copyprop ro.system.build.fingerprint ro.vendor.build.fingerprint
-    copyprop ro.bootimage.build.fingerprint ro.vendor.build.fingerprint
     copyprop ro.build.fingerprint ro.vendor.build.fingerprint
     copyprop ro.build.device ro.vendor.product.device
     copyprop ro.product.system.device ro.vendor.product.device
@@ -807,10 +805,6 @@ if [ -f /system/phh/secure ] || [ -f /metadata/phh/secure ];then
     copyprop ro.product.model ro.product.vendor.model
     copyprop ro.build.product ro.vendor.product.model
     copyprop ro.build.product ro.product.vendor.model
-    copyprop ro.system.product.manufacturer ro.vendor.product.manufacturer
-    copyprop ro.product.manufacturer ro.vendor.product.manufacturer
-    copyprop ro.system.product.manufacturer ro.product.vendor.manufacturer
-    copyprop ro.product.manufacturer ro.product.vendor.manufacturer
     (getprop ro.vendor.build.security_patch; getprop ro.keymaster.xxx.security_patch) |sort |tail -n 1 |while read v;do
         [ -n "$v" ] && resetprop_phh ro.build.version.security_patch "$v"
     done
