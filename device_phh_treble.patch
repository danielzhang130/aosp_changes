From b20063de38c8a23f77372072b4056d5c47cf2d16 Mon Sep 17 00:00:00 2001
From: Daniel Zhang <danielzhang130@gmail.com>
Date: Wed, 14 Dec 2022 20:52:26 -0500
Subject: [PATCH 01/31] Various updates to phh treble device

- make adb secure
- remove su
- remove permissive se policy
- remove chrome

Signed-off-by: Daniel Zhang <danielzhang130@gmail.com>
---
 base.mk              |   1 -
 gapps.mk             |   1 -
 sepolicy/huawei.te   |   1 -
 sepolicy/mediatek.te |   1 -
 sepolicy/su.te       |   1 -
 su/Android.mk        |  11 -----------
 su/su                | Bin 476204 -> 0 bytes
 su/su.rc             |   2 --
 system.prop          |   1 -
 9 files changed, 19 deletions(-)
 delete mode 100644 su/Android.mk
 delete mode 100755 su/su
 delete mode 100644 su/su.rc

diff --git a/base.mk b/base.mk
index 7be9033..e35d4c0 100644
--- a/base.mk
+++ b/base.mk
@@ -35,7 +35,6 @@ PRODUCT_SYSTEM_DEFAULT_PROPERTIES += \
     ro.build.version.all_codenames=$(PLATFORM_VERSION_ALL_CODENAMES) \
     ro.build.version.release=$(PLATFORM_VERSION) \
     ro.build.version.security_patch=$(PLATFORM_SECURITY_PATCH) \
-    ro.adb.secure=0 \
     ro.logd.auditd=true \
     ro.logd.kernel=true \
 
diff --git a/gapps.mk b/gapps.mk
index 15e12a9..744cf31 100644
--- a/gapps.mk
+++ b/gapps.mk
@@ -9,7 +9,6 @@ PRODUCT_PACKAGES := $(filter-out GoogleContacts, $(PRODUCT_PACKAGES))
 
 PRODUCT_PACKAGES += \
 	phh-gapps-overrides \
-	Chrome \
 	GoogleContactsSyncAdapter \
 	talkback \
 
diff --git a/sepolicy/huawei.te b/sepolicy/huawei.te
index 2988ed6..23ed860 100644
--- a/sepolicy/huawei.te
+++ b/sepolicy/huawei.te
@@ -1,5 +1,4 @@
 allow ueventd proc:file r_file_perms;
-permissive ueventd;
 
 type teecd_data_file, file_type;
 type dmd_device, file_type;
diff --git a/sepolicy/mediatek.te b/sepolicy/mediatek.te
index 0344d0f..53c1507 100644
--- a/sepolicy/mediatek.te
+++ b/sepolicy/mediatek.te
@@ -23,7 +23,6 @@ allow { appdomain -isolated_app }  mtk_hal_mms_hwservice:hwservice_manager find;
 #denied { getattr } for comm="tkuinit" path="/dev/__properties__/u:object_r:default_prop:s0" dev="tmpfs" ino=2029 scontext=u:r:tkcore:s0 tcontext=u:object_r:default_prop:s0 tclass=file permissive=1
 
 type tkcore, domain;
-permissive tkcore;
 
 allow platform_app sysfs_leds:dir r_dir_perms;
 allow platform_app sysfs_leds:file r_file_perms;
diff --git a/sepolicy/su.te b/sepolicy/su.te
index ae430a6..345c462 100644
--- a/sepolicy/su.te
+++ b/sepolicy/su.te
@@ -3,7 +3,6 @@ type phhsu_exec, exec_type, file_type;
 type phhsu_daemon_tmpfs, file_type;
 
 typeattribute phhsu_daemon coredomain;
-permissive phhsu_daemon;
 
 tmpfs_domain(phhsu_daemon);
 domain_auto_trans(init, phhsu_exec, phhsu_daemon);
diff --git a/su/Android.mk b/su/Android.mk
deleted file mode 100644
index 4d2e612..0000000
--- a/su/Android.mk
+++ /dev/null
@@ -1,11 +0,0 @@
-LOCAL_PATH := $(call my-dir)
-
-include $(CLEAR_VARS)
-
-LOCAL_SRC_FILES := su
-LOCAL_MODULE := phh-su
-LOCAL_MODULE_CLASS := EXECUTABLES
-
-LOCAL_INIT_RC := su.rc
-
-include $(BUILD_PREBUILT)
diff --git a/su/su b/su/su
deleted file mode 100755
index 59f1aafc91acd17533e0a52a6b6e5cb0acac14c8..0000000000000000000000000000000000000000
GIT binary patch
literal 0
